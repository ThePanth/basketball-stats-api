<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models\Statistic.fs" />
    <Compile Include="Models\Player.fs" />
    <Compile Include="Models\Game.fs" />
    <Compile Include="Storage\PlayerStorage.fs" />
    <Compile Include="Storage\StatisticsStorage.fs" />
    <Compile Include="Storage\GameStorage.fs" />
    <Compile Include="Mongo\Models.fs" />
    <Compile Include="Mongo\ModelMapper.fs" />
    <Compile Include="Mongo\Storage\StatisticsStorage.fs" />
    <Compile Include="Mongo\Storage\PlayerStorage.fs" />
    <Compile Include="Mongo\Storage\GameStorage.fs" />
    <Compile Include="DI.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2" />
    <PackageReference Include="MongoDB.Driver" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasketballStats.Utils\BasketballStats.Utils.fsproj" />
  </ItemGroup>

</Project>
